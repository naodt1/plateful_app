<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the process is starting (before Flutter draws its first frame). -->
    <!-- Material parent is required by RevenueCat Paywall / Customer Center fragments. -->
    <style name="LaunchTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/brand_green</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <!-- Material parent required by RevenueCat Paywall / Customer Center fragments. -->
    <style name="NormalTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
